{
  "name": "geo-polygonize",
  "version": "0.11.0",
  "description": "A native Rust port of the JTS/GEOS polygonization algorithm (Wasm)",
  "type": "module",
  "scripts": {
    "build": "./scripts/build_wasm.sh",
    "test": "vitest run",
    "prepare": "husky"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/standard/es/index.js",
      "require": "./dist/standard/cjs/index.js",
      "types": "./dist/standard/es/index.d.ts",
      "default": "./dist/standard/es/index.js"
    },
    "./slim": {
      "import": "./dist/slim/es/index_slim.js",
      "require": "./dist/slim/cjs/index_slim.js",
      "types": "./dist/slim/es/index_slim.d.ts",
      "default": "./dist/slim/es/index_slim.js"
    },
    "./threads": {
      "import": "./dist/threads/es/index.js",
      "types": "./dist/threads/es/index.d.ts",
      "default": "./dist/threads/es/index.js"
    },
    "./geo_polygonize.wasm": "./dist/geo_polygonize.wasm",
    "./geo_polygonize_simd.wasm": "./dist/geo_polygonize_simd.wasm",
    "./*": "./dist/*"
  },
  "types": "./dist/standard/es/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/graydonpleasants/geo-polygonize"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@rollup/plugin-url": "^8.0.2",
    "husky": "^9.1.7",
    "rollup": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "sideEffects": false,
  "author": "",
  "license": "MIT"
}
