{
  "name": "geo-polygonize",
  "version": "0.39.3",
  "description": "A native Rust port of the JTS/GEOS polygonization algorithm (Wasm)",
  "type": "module",
  "scripts": {
    "build": "./scripts/build_wasm.sh",
    "test": "vitest run",
    "prepare": "husky",
    "build:site-lib": "SITE_BUILD=1 ./scripts/build_wasm.sh",
    "docs:extract": "cargo run -p xtask -- docs extract",
    "docs:render": "cargo run -p xtask -- docs render",
    "docs:gen:examples": "node ./scripts/docs/gen-examples.mjs",
    "docs:gen": "npm run docs:extract && npm run docs:render && npm run docs:gen:examples",
    "docs:dev": "npm run build:site-lib && npm run docs:gen && vitepress dev docs",
    "docs:build": "npm run build:site-lib && npm run docs:gen && vitepress build docs && cd playground && npm install && npm run build"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/standard/es/index.js",
      "require": "./dist/standard/cjs/index.js",
      "types": "./dist/standard/es/index.d.ts",
      "default": "./dist/standard/es/index.js"
    },
    "./slim": {
      "import": "./dist/slim/es/index_slim.js",
      "require": "./dist/slim/cjs/index_slim.js",
      "types": "./dist/slim/es/index_slim.d.ts",
      "default": "./dist/slim/es/index_slim.js"
    },
    "./threads": {
      "import": "./dist/threads/es/index.js",
      "types": "./dist/threads/es/index.d.ts",
      "default": "./dist/threads/es/index.js"
    },
    "./geo_polygonize.wasm": "./dist/geo_polygonize.wasm",
    "./geo_polygonize_simd.wasm": "./dist/geo_polygonize_simd.wasm",
    "./*": "./dist/*"
  },
  "types": "./dist/standard/es/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/graydonpleasants/geo-polygonize"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@rollup/plugin-url": "^8.0.2",
    "husky": "^9.1.7",
    "playwright-core": "^1.55.0",
    "rollup": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18",
    "vitepress": "^1.0.0",
    "vite": "^4.2.0"
  },
  "sideEffects": false,
  "author": "",
  "license": "MIT"
}
