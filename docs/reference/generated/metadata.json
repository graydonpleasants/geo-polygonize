      "PolygonizerOptions": {
        "name": "PolygonizerOptions",
        "docs": "The canonical configuration object for the `geo-polygonize` engine.\n\nThis struct controls every aspect of the polygonization pipeline, including\ntopological robustness, feature output, containment policies, noding, and determinism.",
        "fields": [
          {
            "name": "target",
            "docs": "Determines the execution environment profile (e.g., Native, WasmSingleThread, WasmThreads).\n\nDefault: `TargetProfile::Native`",
            "ty": "TargetProfile",
            "is_optional": false
          },
          {
            "name": "node_input",
            "docs": "Whether to robustly node the input before polygonization.\n\nEnable this for real-world linework where segment intersections may not\nalready exist as explicit vertices. This is slower than the fast path but\navoids missing faces and unresolved crossings.\n\nDefault: `false`",
            "ty": "bool",
            "is_optional": false
          },
          {
            "name": "snap_grid_size",
            "docs": "The snapping grid size used for vertex deduplication and noding operations.\n\nVertices falling within the same grid cell are coalesced. A size of `0.0`\nindicates exact floating-point evaluation without grid snapping.\n\nDefault: `1e-10`",
            "ty": "f64",
            "is_optional": false
          },
          {
            "name": "extract_only_polygonal",
            "docs": "If `true`, only pure, outermost polygonal shells are returned.\n\nFloating dangles, internal cut-lines, or invalid rings will be discarded.\n\nDefault: `false`",
            "ty": "bool",
            "is_optional": false
          },
          {
            "name": "snap_strategy",
            "docs": "The underlying strategy to apply when snapping coordinate geometries.\n\nSee `SnapStrategy` for differences between strict `Grid` snapping and\nShapely/GEOS `GeosCompat` strategies.\n\nDefault: `SnapStrategy::Grid`",
            "ty": "SnapStrategy",
            "is_optional": false
          },
          {
            "name": "noding",
            "docs": "Configures the noding engine backend and behavior.",
            "ty": "NodingOptions",
            "is_optional": false
          },
          {
            "name": "containment",
            "docs": "Configures how topological relationships (containment) are calculated\nduring face formation.",
            "ty": "ContainmentOptions",
            "is_optional": false
          },
          {
            "name": "tiling",
            "docs": "Optional configuration for tiled, distributed execution across huge datasets.",
            "ty": "Option<TilingOptions>",
            "is_optional": true
          },
          {
            "name": "z",
            "docs": "Configures Z-axis coordinate handling.",
            "ty": "ZOptions",
            "is_optional": false
          },
          {
            "name": "determinism",
            "docs": "Configuration for enforcing exact topological determinism.",
            "ty": "DeterminismOptions",
            "is_optional": false
          },
          {
            "name": "diagnostics",
            "docs": "Options for capturing diagnostic topology failures.",
            "ty": "DiagnosticsOptions",
            "is_optional": false
          },
          {
            "name": "provenance",
            "docs": "Options for mapping final faces back to original input geometry IDs.",
            "ty": "ProvenanceOptions",
            "is_optional": false
          },
          {
            "name": "input_profile_id",
            "docs": "An optional identifier for the input dataset.",
            "ty": "Option<String>",
            "is_optional": true
          }
        ]
      },
